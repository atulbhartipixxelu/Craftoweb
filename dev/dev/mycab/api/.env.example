APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# React SPA base (OAuth redirect after Google). Must match how you open the app (port + Vite base path).
FRONTEND_URL=http://localhost:5173/dev/mycab

# Google Sign-In (Laravel Socialite). Authorized redirect URI in Google Cloud Console:
#   {APP_URL}/auth/google/callback   e.g. http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Filament admin panel: http://localhost:8000/admin (with php artisan serve)
# Default admin (after: php artisan db:seed --class=AdminUserSeeder):
#   Email: admin@himcab.local   Password: password   (change in production)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Ride emails (passenger + driver). Use `log` locally — bodies appear in storage/logs/laravel.log
# For real SMTP: smtp + MAIL_HOST, etc.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Geocoding (OpenStreetMap Nominatim). On Windows/WAMP, SSL often fails until you install a CA bundle.
# Local default: verify SSL is OFF when APP_ENV is local/testing (see config/services.php).
# Production: set APP_ENV=production and optionally NOMINATIM_SSL_VERIFY=true
# NOMINATIM_SSL_VERIFY=false
# NOMINATIM_CA_BUNDLE="C:/path/to/cacert.pem"

VITE_APP_NAME="${APP_NAME}"
